# Copiare questo file in .env e inserire il token personale ricevuto da football-data.org.
# Non salvare mai il token in app.js, index.html o in un commit Git.
FOOTBALL_DATA_TOKEN=
PORT=3000

# MySQL HeatWave: raggiungibile solo da una macchina collegata alla VCN.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=matchday
# Percorso locale sul server del certificato TLS del DB (PEM).
MYSQL_SSL_CA_PATH=
# Facoltativo: FQDN TLS del DB, utile se si usa un tunnel SSH locale.
MYSQL_SSL_SERVERNAME=


